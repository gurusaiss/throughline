# Copy to .env and fill in. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required to store tenant-supplied provider API keys encrypted at rest. Leave blank in development if
# you are not using bring-your-own-key provider accounts.
ENCRYPTION_KEY=

DATABASE_URL=postgresql+asyncpg://throughline:throughline@localhost:5432/throughline
REDIS_URL=redis://localhost:6379/0

# Comma-separated list, no spaces required. Never "*" in production.
CORS_ORIGINS_RAW=http://localhost:3000

# --- Provider credentials -------------------------------------------------------------
# The platform works with zero keys set (the scripted offline provider still runs), but no real model
# calls happen until at least one of these is set. Anthropic is the only provider whose pricing in
# app/registry/catalog.yaml has been verified against primary documentation — see docs/RESEARCH.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# --- Orchestration policy --------------------------------------------------------------
FAST_PATH_CONFIDENCE_THRESHOLD=0.72
MAX_CANDIDATES=3
MAX_REPAIR_ATTEMPTS=1
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_MAX_RETRIES=2

# --- Cost controls ----------------------------------------------------------------------
DEFAULT_ORG_MONTHLY_BUDGET_USD=25.0
BUDGET_SAFETY_MARGIN=1.25
ENABLE_EXACT_CACHE=true
CACHE_TTL_SECONDS=3600
# Leave false. Semantic caching is not production-ready — see ADR-005 in docs/DECISIONS.md.
ENABLE_SEMANTIC_CACHE=false

# --- Evaluation policy --------------------------------------------------------------------
ENABLE_JUDGE=true
JUDGE_SAMPLING_RATE=1.0
# Leave blank to let the router pick a cross-family judge automatically.
JUDGE_MODEL_ID=

# --- Privacy ------------------------------------------------------------------------------
# Keep false unless you have reviewed the retention and data-handling implications (docs/SECURITY.md).
LOG_RAW_PROMPTS=false
DEFAULT_RETENTION_DAYS=90
